<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0"
      prefWidth="850.0"
      spacing="0.0"
      stylesheets="@../style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.unicaen.controller.dialog.AuthorCardController">

    <children>
        <BorderPane VBox.vgrow="ALWAYS">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="18.0"
                      style="-fx-background-color: #0f1c2e; -fx-padding: 18px;">

                    <children>
                        <StackPane prefHeight="150.0" prefWidth="120.0">
                            <children>
                                <ImageView fx:id="authorPhotoView"
                                           fitHeight="150.0"
                                           fitWidth="120.0"
                                           preserveRatio="true" />
                                <ProgressIndicator fx:id="imageSpinner"
                                                   maxHeight="32.0"
                                                   maxWidth="32.0" />
                            </children>
                        </StackPane>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="authorNameLabel"
                                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"
                                       text="Nom de l'auteur" />

                                <Label fx:id="authorShortDescLabel"
                                       style="-fx-font-size: 13px; -fx-text-fill: #cbd5e1;"
                                       text="Description courte"
                                       wrapText="true" />

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label fx:id="authorIdBadge"
                                               style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: #f8fafc; -fx-padding: 4px 8px; -fx-background-radius: 6px;"
                                               text="ID" />

                                        <Label fx:id="worksCountBadge"
                                               style="-fx-background-color: rgba(241,196,15,0.18); -fx-text-fill: #f1c40f; -fx-padding: 4px 8px; -fx-background-radius: 6px;"
                                               text="0 œuvre(s)" />

                                        <Label fx:id="movementBadge"
                                               style="-fx-background-color: rgba(148,163,184,0.18); -fx-text-fill: #cbd5e1; -fx-padding: 4px 8px; -fx-background-radius: 6px;"
                                               text="Mouvement" />

                                        <Label fx:id="wikidataIdBadge"
                                               style="-fx-background-color: rgba(56,189,248,0.18); -fx-text-fill: #38bdf8; -fx-padding: 4px 8px; -fx-background-radius: 6px;"
                                               text="QID" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnOpenWikidata"
                                                onAction="#handleOpenWikidata"
                                                text="Voir sur Wikidata" />

                                        <Button fx:id="btnOpenWikipedia"
                                                onAction="#handleOpenWikipedia"
                                                text="Article Wikipédia" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </top>

            <center>
                <TabPane fx:id="cardTabPane" tabClosingPolicy="UNAVAILABLE">

                    <tabs>
                        <Tab text="Fiche Personnelle &amp; Wikidata">
                            <content>
                                <ScrollPane fitToWidth="true">
                                    <content>
                                        <VBox spacing="16.0" style="-fx-padding: 16px; -fx-background-color: #f8fafc;">

                                            <children>
                                                <VBox spacing="8.0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                            <children>
                                                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f1c2e;"
                                                                       text="Biographie &amp; Contexte" />
                                                                <Region HBox.hgrow="ALWAYS" />
                                                                <ProgressIndicator fx:id="bioSpinner"
                                                                                   maxHeight="18.0"
                                                                                   maxWidth="18.0" />
                                                            </children>
                                                        </HBox>

                                                        <Label fx:id="biographyLabel"
                                                               style="-fx-text-fill: #334155; -fx-font-size: 12px;"
                                                               text="Chargement de la biographie..."
                                                               wrapText="true" />
                                                    </children>
                                                </VBox>

                                                <Separator />

                                                <HBox spacing="18.0">
                                                    <children>
                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                                    <children>
                                                                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0f1c2e;"
                                                                               text="État Civil &amp; Lieux" />
                                                                    </children>
                                                                </HBox>

                                                                <Label text="Naissance :" />
                                                                <Label fx:id="lblBirthDate" text="Non renseignée" />

                                                                <Label text="Lieu de naissance :" />
                                                                <Label fx:id="lblBirthPlace" text="Non renseigné" />

                                                                <Label text="Décès :" />
                                                                <Label fx:id="lblDeathDate" text="Non renseigné" />

                                                                <Label text="Lieu de décès :" />
                                                                <Label fx:id="lblDeathPlace" text="Non renseigné" />

                                                                <Label text="Nationalité :" />
                                                                <Label fx:id="lblCitizenship" text="Non renseignée" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                                    <children>
                                                                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0f1c2e;"
                                                                               text="Profil Littéraire &amp; Métiers" />
                                                                    </children>
                                                                </HBox>

                                                                <Label text="Mouvement :" />
                                                                <Label fx:id="lblMovementDetails" text="Non renseigné" wrapText="true" />

                                                                <Label text="Occupations :" />
                                                                <Label fx:id="lblOccupations" text="Non renseignées" wrapText="true" />

                                                                <Label text="Genres :" />
                                                                <Label fx:id="lblGenres" text="Non renseignés" wrapText="true" />

                                                                <Label text="Récompenses :" />
                                                                <Label fx:id="lblAwards" text="Non renseignées" wrapText="true" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <Separator />

                                                <VBox spacing="8.0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                            <children>
                                                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0f1c2e;"
                                                                       text="Œuvres Majeures Répertoriées Wikidata" />
                                                            </children>
                                                        </HBox>

                                                        <Label fx:id="noNotableWorksLabel"
                                                               style="-fx-text-fill: #64748b;"
                                                               text="Aucune œuvre notable récupérée." />

                                                        <FlowPane fx:id="notableWorksFlowPane"
                                                                  hgap="8.0"
                                                                  vgap="8.0" />
                                                    </children>
                                                </VBox>

                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label fx:id="syncStatusLabel"
                                                               style="-fx-text-fill: #64748b;"
                                                               text="Métadonnées prêtes à être synchronisées." />

                                                        <Region HBox.hgrow="ALWAYS" />

                                                        <Button fx:id="btnSyncDatabase"
                                                                onAction="#handleSyncDatabase"
                                                                text="Enregistrer en BDD locale" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>

                        <Tab text="Textes dans le Corpus SQLite">
                            <content>
                                <VBox spacing="12.0" style="-fx-padding: 16px; -fx-background-color: #f8fafc;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="localTextsCountLabel"
                                                       style="-fx-font-weight: bold; -fx-text-fill: #0f1c2e;"
                                                       text="0 document(s) enregistré(s)" />
                                            </children>
                                        </HBox>

                                        <HBox fx:id="noTextsMessageBox"
                                              alignment="CENTER_LEFT"
                                              style="-fx-background-color: #fff7ed; -fx-padding: 10px; -fx-background-radius: 8px;">
                                            <children>
                                                <Label style="-fx-text-fill: #9a3412;"
                                                       text="Aucun texte local enregistré pour cet auteur." />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="authorTextsTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colTextId" prefWidth="70.0" text="ID" />
                                                <TableColumn fx:id="colTextTitle" prefWidth="260.0" text="Titre" />
                                                <TableColumn fx:id="colTextPath" prefWidth="360.0" text="Chemin" />
                                                <TableColumn fx:id="colTextAction" prefWidth="110.0" text="Action" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT"
                      spacing="10.0"
                      style="-fx-padding: 10px; -fx-background-color: #f1f5f9;">
                    <children>
                        <Label fx:id="footerInfoLabel"
                               style="-fx-text-fill: #64748b;"
                               text="En attente des données." />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#handleClose" text="Fermer" />
                    </children>
                </HBox>
            </bottom>

        </BorderPane>
    </children>
</VBox>