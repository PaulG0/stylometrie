<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.unicaen.controller.list.AuthorsListController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <!-- BARRE DE COMMANDE & BASCULE DE VUE -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f1c2e;" text="Référentiel des Écrivains" />
                        <Label fx:id="totalCountLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="0 auteur(s) en base" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- RECHERCHE EN TEMPS RÉEL -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher un nom, mouvement..." style="-fx-pref-width: 220px;" />

                <!-- OPTION DU NOMBRE DE LIGNES PAR PAGE -->
                <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Affichage :" />
                <ComboBox fx:id="pageSizeComboBox" style="-fx-pref-width: 90px;" />

                <!-- BASCULE GALERIE / TABLEAU -->
                <HBox styleClass="toggle-button-group">
                    <children>
                        <ToggleButton fx:id="tableModeBtn" selected="true" text="📋 Tableau">
                            <toggleGroup>
                                <ToggleGroup fx:id="viewGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="galleryModeBtn" text="🖼️ Galerie" toggleGroup="$viewGroup" />
                    </children>
                </HBox>

                <Button fx:id="btnViewCard" onAction="#onViewAuthorCardClick" styleClass="button" text="👁️ Fiche Auteur" />
                <Button onAction="#onRefreshClick" styleClass="button" text="🔄" />
            </children>
        </HBox>

        <!-- STACK PANE : CONTENANT SOIT LE TABLEAU SOIT LA GALERIE -->
        <StackPane VBox.vgrow="ALWAYS">
            <children>

                <!-- VUE 1 : TABLEAU DYNAMIQUE -->
                <VBox fx:id="tableViewBox" spacing="10.0">
                    <children>
                        <TableView fx:id="authorsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="colAction" prefWidth="65.0" text="Fiche" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colName" prefWidth="200.0" text="Auteur" />
                                <TableColumn fx:id="colBirthDate" prefWidth="100.0" text="Naissance" />
                                <TableColumn fx:id="colMovement" prefWidth="160.0" text="Mouvement" />
                                <TableColumn fx:id="colWorksCount" prefWidth="110.0" text="Nb Œuvres" />
                                <TableColumn fx:id="colUri" prefWidth="260.0" text="URI Wikidata" />
                            </columns>
                            <!-- CODE CORRIGÉ -->
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- VUE 2 : GALERIE D'IMAGES DYNAMIQUES -->
                <ScrollPane fx:id="galleryScrollView" fitToWidth="true" visible="false" style="-fx-background-color: transparent;">
                    <content>
                        <FlowPane fx:id="galleryFlowPane" hgap="15.0" vgap="15.0" style="-fx-padding: 10px;" />
                    </content>
                </ScrollPane>

            </children>
        </StackPane>

        <!-- PAGINATION DYNAMIQUE -->
        <HBox alignment="CENTER">
            <children>
                <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
            </children>
        </HBox>

    </children>
</VBox>